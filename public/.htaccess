<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Передаём Authorization header в PHP-CGI (Beget стриппит его иначе)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Корень / → лендинг
    RewriteRule ^$ index.html [L]

    # Статические файлы — напрямую
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # /event/{slug} → event-form.html (slug читает JS из location.pathname)
    RewriteRule ^event/[a-z0-9\-]+/?$ /event-form.html [L]

    # Чистые URL без .html: /calendar → calendar.html
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
    RewriteRule ^(.+)$ /$1.html [L]

    # Всё остальное → Laravel (API, routes)
    RewriteRule ^ index.php [L]
</IfModule>
AddHandler application/x-httpd-php83 .php
